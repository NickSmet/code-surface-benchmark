# The live model both surfaces benchmark against. Copy to .env and fill in.
# The app falls back to a deterministic offline stub when nothing is set,
# so the UI still runs with no keys at all.

# --- Option A: plain OpenAI (simplest — the key is all you need) ---
OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-5.4-mini"                  # default: gpt-5.4-mini
# OPENAI_BASE_URL="https://api.openai.com/v1"  # point at any OpenAI-compatible
#                                              # server (Ollama, LM Studio, vLLM);
#                                              # with a custom base URL the key is optional

# --- Option B: Azure OpenAI (needs a provisioned deployment — see tf/) ---
# Takes precedence over Option A when endpoint + key are both set.
# AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com"
# AZURE_OPENAI_API_KEY="<your-key>"
# AZURE_OPENAI_DEPLOYMENT="gpt-5.4-mini"
# AZURE_OPENAI_API_VERSION="2025-04-01-preview"

# Optional: override the per-1M-token prices used for the cost column
# (USD). Defaults live in src/lib/agent/pricing.ts.
# BENCH_PRICE_INPUT_PER_M="2.50"
# BENCH_PRICE_CACHED_INPUT_PER_M="0.25"
# BENCH_PRICE_OUTPUT_PER_M="10.00"
